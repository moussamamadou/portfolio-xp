---
import { labs, person } from '../data/content.js';
---

<section class="sect labs" id="labs" aria-labelledby="labs-title">
  <header class="sect__head">
    <h2 class="big" id="labs-title" data-lines>(3) Labs</h2>
    <p class="cap">Small experiments,<br />all on CodePen.</p>
  </header>

  <ol class="rows">
    {labs.map((l, i) => (
      <li class="row rule" style={`--i:${i}`} data-rule>
        <a class="row__head" href={l.codepen ?? person.codepen} target="_blank" rel="noopener">
          <span class="row__label big"><span data-rise>(L{l.num}) {l.title}</span></span>
          <span class="row__cap cap">{l.tools.join(', ')}<br />Open on CodePen ↗</span>
        </a>
      </li>
    ))}
  </ol>
</section>
