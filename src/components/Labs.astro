---
import { labs, person } from '../data/content.js';
const entries = ['left', 'top', 'right'];
---

<section class="labs section" id="labs" aria-labelledby="labs-title">
  <canvas class="labs__field" data-labs-field aria-hidden="true"></canvas>

  <div class="labs__head">
    <div class="section__label mono"><span>(03)</span><span>Labs</span></div>
    <h2 class="labs__title" id="labs-title">
      <span class="labs__title-big">LABS</span>
      <span class="labs__title-sub" data-scramble>Where Creativity Runs Wild</span>
    </h2>
    <p class="labs__intro">A collection of experimental projects built to flex and show off my creative muscle.</p>
  </div>

  <div class="labs__table" data-labs-table>
    <p class="labs__drag-hint mono" aria-hidden="true">These are draggable. Go on, make a mess.</p>
    {
      labs.map((lab, i) => (
        <article class="specimen" data-specimen data-from={entries[i]}>
          <div class="specimen__card" data-specimen-card data-cursor="Drag">
          <div class="specimen__top mono">
            <span>Clonable {lab.num}</span>
            <span class="specimen__barcode" aria-hidden="true" />
          </div>
          <h3 class="specimen__title">{lab.title}</h3>
          <ul class="specimen__tools">
            {lab.tools.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
          <div class="specimen__links">
            <a href={lab.codepen ?? person.codepen} target="_blank" rel="noopener" class="specimen__link">
              CodePen ↗
            </a>
            <a href={lab.webflow ?? person.webflow} target="_blank" rel="noopener" class="specimen__link">
              Webflow ↗
            </a>
          </div>
          {!lab.codepen && <p class="specimen__note mono">Links go to profiles until the direct ones are added</p>}
          </div>
        </article>
      ))
    }
  </div>

  <div class="labs__foot">
    <p class="labs__copy">
      These experiments are more than just code, they're <em>playgrounds for creativity</em>. Feel free to explore, clone, and steal some inspiration.
    </p>
    <div class="labs__profiles">
      <a href={person.webflow} target="_blank" rel="noopener" class="btn btn--line" data-magnetic>Clonables on Webflow <span class="btn__arrow" aria-hidden="true">↗</span></a>
      <a href={person.codepen} target="_blank" rel="noopener" class="btn btn--line" data-magnetic>CodePen <span class="btn__arrow" aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
