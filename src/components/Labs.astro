---
import { labs, person } from '../data/content.js';
---

<section class="labs section" id="labs" aria-labelledby="labs-title">
  <p class="kicker mono"><span>(03)</span><span>Labs</span><span>Experiments on CodePen</span></p>

  <h2 class="labs__title" id="labs-title" data-lines>Where creativity runs wild</h2>

  <ol class="labs__list">
    {
      labs.map((lab) => (
        <li class="lab" data-lab>
          <a class="lab__link" href={lab.codepen ?? person.codepen} target="_blank" rel="noopener" data-cursor="CodePen ↗">
            <span class="lab__rule" aria-hidden="true" />
            <span class="lab__num mono">(L{lab.num})</span>
            <span class="lab__title">{lab.title}</span>
            <span class="lab__tools mono">{lab.tools.join(' · ')}</span>
            <span class="lab__go mono">CodePen ↗</span>
            <span class="lab__fill" aria-hidden="true">
              <span class="lab__num mono">(L{lab.num})</span>
              <span class="lab__title">{lab.title}</span>
              <span class="lab__tools mono">{lab.tools.join(' · ')}</span>
              <span class="lab__go mono">CodePen ↗</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</section>
