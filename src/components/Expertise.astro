---
import { skillGroups, person } from '../data/content.js';
---

<section class="expertise section" id="expertise" aria-labelledby="expertise-title">
  <div class="expertise__head">
    <div class="section__label mono"><span>(04)</span><span>Expertise</span></div>
    <p class="expertise__kicker mono">My developer toolkit</p>
    <h2 class="expertise__title" id="expertise-title" data-weight-wave>Things I Actually Know How To Use</h2>
  </div>

  <div class="expertise__grid">
    <div class="playground" data-playground data-cursor="Throw">
      <p class="playground__hint mono" aria-hidden="true">Grab one. Throw it. It's fine.</p>
      <button class="playground__shake mono" type="button" data-shake>Shake it ↯</button>
      <div class="playground__bodies" aria-hidden="true">
        {
          skillGroups.flatMap((g) =>
            g.items.map((s) => (
              <div class={`pill pill--${g.id}`} data-pill data-group={g.id} data-name={s.name}>
                <span class="pill__name">{s.name}</span>
                <span class="pill__note">{s.note}</span>
              </div>
            )),
          )
        }
      </div>
    </div>

    <div class="legend">
      {
        skillGroups.map((g) => (
          <div class="legend__group" data-legend-group={g.id}>
            <h3 class="legend__title mono">
              <span class={`legend__swatch legend__swatch--${g.id}`} aria-hidden="true" />
              {g.title}
            </h3>
            <ul class="legend__list">
              {g.items.map((s) => (
                <li class="legend__item" data-legend-item={s.name}>
                  <span class="legend__name">{s.name}</span>
                  <span class="legend__note">{s.note}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <p class="expertise__closing">
    I'm always learning and experimenting, pushing the boundaries of what's possible with modern web development.
    <a href={person.website} target="_blank" rel="noopener" class="link">moussamamadou.me ↗</a>
  </p>
</section>
