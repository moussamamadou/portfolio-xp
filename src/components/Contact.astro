---
import { person } from '../data/content.js';
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <p class="kicker mono"><span>(05)</span><span>Contact</span><span>Just an email away</span></p>

  <h2 class="contact__title" id="contact-title" aria-label="Let's build something">
    <span class="contact__line" aria-hidden="true"><span data-contact-split>Let's build</span></span>
    <span class="contact__line" aria-hidden="true"><span data-contact-split>something</span></span>
  </h2>

  <div class="contact__links">
    <a class="contact__mail" href={`mailto:${person.email}`} data-cursor="Write ↗">
      <span class="roll" data-roll>{person.email}</span>
    </a>
    <div class="contact__row mono">
      <button type="button" class="contact__copy" data-copy={person.email}><span data-copy-label>Copy address</span></button>
      <a href={person.linkedin} target="_blank" rel="noopener"><span data-scramble>LinkedIn</span> ↗</a>
      <a href={person.codepen} target="_blank" rel="noopener"><span data-scramble>CodePen</span> ↗</a>
    </div>
  </div>

  <footer class="footer mono">
    <p>© 2026 Moussa Mamadou</p>
    <p>Your time <span data-clock>--:--:--</span></p>
    <p>Designed &amp; coded by me</p>
    <a href="#top" data-scroll-to>Back to top ↑</a>
  </footer>

  <p class="mark" aria-hidden="true"><span data-mark>Moussa</span></p>
</section>
