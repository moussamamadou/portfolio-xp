---
import { person } from '../data/content.js';
---

<section class="slide slide--dark contact" id="contact" aria-labelledby="contact-title">
  <img class="slide__bg" src="/textures/hide-dark.jpg" alt="" aria-hidden="true" data-parallax />
  <div class="slide__body">
    <h2 class="contact__title big" id="contact-title" data-lines>Let's make something together</h2>
    <div class="contact__side cap" data-fade>
      <a href={`mailto:${person.email}`}>{person.email} ↗</a>
      <button type="button" data-copy={person.email}><span data-copy-label>Copy the address</span></button>
      <a href={person.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
      <a href={person.codepen} target="_blank" rel="noopener">CodePen ↗</a>
    </div>
  </div>
  <div class="slide__foot">
    <p class="slide__num big" aria-hidden="true">(5)</p>
    <div class="cap contact__foot">
      <p>© 2026 Moussa Mamadou</p>
      <p>Your time <span data-clock>--:--:--</span></p>
      <a href="#top" data-scroll-to>Back to top ↑</a>
    </div>
  </div>
</section>
