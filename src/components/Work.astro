---
import { projects } from '../data/content.js';
const live = (p) => p.link && p.link !== 'soon';
---

<section class="work section" id="work" aria-labelledby="work-title">
  <p class="kicker mono"><span>(02)</span><span>Work</span><span>({String(projects.length).padStart(2, '0')}) Projects</span></p>

  <h2 class="work__title" id="work-title" aria-label="Selected works">
    <span class="work__title-line" aria-hidden="true"><span data-work-split>Selected</span></span>
    <span class="work__title-line" aria-hidden="true"><span data-work-split>(Works)</span></span>
  </h2>

  <ol class="work__grid">
    {
      projects.map((p, i) => {
        const Tag = live(p) ? 'a' : 'div';
        return (
          <li class={`tile tile--${i + 1}`} data-tile>
            <Tag
              class="tile__link"
              {...(live(p) ? { href: p.link, target: '_blank', rel: 'noopener' } : {})}
              data-cursor={live(p) ? 'Visit ↗' : 'Launching soon'}
            >
              <div class="tile__media" style={`aspect-ratio: ${p.ratio}`} data-tile-media>
                <img src={p.image} alt={`${p.title} website`} loading="lazy" decoding="async" data-gl-img />
              </div>
              <div class="tile__caption">
                <span class="tile__num mono">({p.num.padStart(3, '0')})</span>
                <h3 class="tile__title">
                  <span class="roll" data-roll>{p.title}</span>
                </h3>
                <span class="tile__kind mono">{p.kind}</span>
                <span class="tile__stack mono">{p.stack.join(' · ')}</span>
                <span class="tile__go mono">{live(p) ? 'Visit ↗' : 'Soon'}</span>
              </div>
            </Tag>
          </li>
        );
      })
    }
  </ol>
</section>
