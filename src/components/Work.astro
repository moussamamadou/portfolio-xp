---
import { projects } from '../data/content.js';
---

<section class="sect work" id="work" aria-labelledby="work-title">
  <header class="sect__head">
    <h2 class="big" id="work-title" data-lines>(2) Selected work</h2>
    <p class="cap">Seven projects, shipped.<br />Open one to see it whole.</p>
  </header>

  <ol class="rows">
    {projects.map((p, i) => (
      <li class="row rule" style={`--i:${i}`} data-rule data-row>
        <button type="button" class="row__head" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`p-${p.num}`} data-row-head>
          <span class="row__label big"><span data-rise>({p.num}) {p.title}</span></span>
          <span class="row__cap cap">{p.kind}<br />{p.link === 'soon' ? 'Launching soon' : p.stack.slice(0, 2).join(', ')}</span>
        </button>
        <div class="row__panel" id={`p-${p.num}`} data-row-panel data-open={i === 0 ? '' : undefined}>
          <div class="row__inner">
            <img src={p.image} alt={`${p.title} website`} style={`aspect-ratio:${p.ratio}`} loading="lazy" decoding="async" />
            <div class="row__info cap">
              <p>{p.description}</p>
              <p>Role<br />{p.role}</p>
              <p>Stack<br />{p.stack.join(', ')}</p>
              {p.link === 'soon' ? <p>Launching soon</p> : <a href={p.link} target="_blank" rel="noopener">Visit the site ↗</a>}
            </div>
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>
