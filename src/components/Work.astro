---
import { projects } from '../data/content.js';
---

<section class="work section" id="work" aria-labelledby="work-title">
  <div class="work__head">
    <div class="section__label mono"><span>(02)</span><span>Work</span></div>
    <h2 class="work__title" id="work-title" data-mask-lines>Projects I'm<br />Proud Of</h2>
    <p class="work__sub" data-mask-lines>A selection of work where creativity meets clean code.</p>
    <p class="work__hint mono" aria-hidden="true">Keep scrolling, it goes sideways →</p>
  </div>

  <div class="work__pin" data-work-pin>
    <div class="work__counter mono" aria-hidden="true">
      <span class="work__counter-window"><span class="work__counter-reel" data-counter-reel>{projects.map((p) => <span>{p.num}</span>)}</span></span>
      <span>/ 0{projects.length}</span>
    </div>
    <div class="work__track" data-work-track>
      {
        projects.map((p) => (
          <article class="project" data-project>
            <span class="project__num" aria-hidden="true" data-project-num>
              {p.num}
            </span>
            <div class="project__visual" data-cursor="Soon" data-project-visual>
              <div class={`art art--${p.art}`} aria-hidden="true">
                <i />
                <i />
                <i />
                <i />
                <i />
                <i />
              </div>
              <span class="project__visual-note mono">Placeholder visual</span>
            </div>
            <div class="project__body">
              <p class="project__kind mono">{p.num} — {p.kind}</p>
              <h3 class="project__title" data-project-title>
                {p.title}
              </h3>
              {p.description && <p class="project__desc">{p.description}</p>}
              <dl class="project__meta">
                <div>
                  <dt class="mono">Role</dt>
                  <dd class:list={[{ tbd: p.role === 'TBD' }]}>{p.role}</dd>
                </div>
                <div>
                  <dt class="mono">Stack</dt>
                  <dd class:list={[{ tbd: p.stack[0] === 'TBD' }]}>{p.stack.join(' · ')}</dd>
                </div>
                <div>
                  <dt class="mono">Link</dt>
                  <dd>
                    {p.link ? (
                      <a href={p.link} target="_blank" rel="noopener" class="link">
                        Visit site ↗
                      </a>
                    ) : (
                      <span class="tbd">TBD</span>
                    )}
                  </dd>
                </div>
              </dl>
            </div>
          </article>
        ))
      }
      <div class="work__end">
        <p class="work__end-q">Want to build something cool too?</p>
        <a href="#contact" class="btn btn--blue btn--xl" data-scroll-to data-magnetic>
          <span class="btn__label"><span class="roll" data-roll>Let's do it</span></span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
