---
import { projects } from '../data/content.js';
---

<section class="work" id="work" aria-labelledby="work-title">
  <header class="work__head">
    <p class="kicker mono"><span>(02)</span><span>Work</span><span>{projects.length} projects</span></p>
    <h2 class="work__title display" id="work-title">
      <span class="work__a" data-work-a>Selected</span>
      <span class="work__b" data-work-b>Work</span>
    </h2>
  </header>

  <div class="stack" style={`--n:${projects.length}`}>
    {projects.map((p, i) => (
      <>
        <span class="stack__anchor" data-anchor aria-hidden="true" />
        <article class="proj" style={`--i:${i}`} data-proj aria-labelledby={`proj-${p.num}`}>
          <button type="button" class="proj__row mono" data-proj-row={i}>
            <span class="proj__num">{p.num}</span>
            <span class="proj__name">{p.title}</span>
            <span class="proj__kind">{p.kind}</span>
            <span class="proj__stack">{p.stack.join(', ')}</span>
            <span class="proj__plus" aria-hidden="true">+</span>
          </button>
          <div class="proj__body">
            <div class="proj__text">
              <h3 class="proj__title display" id={`proj-${p.num}`}><span data-proj-title>{p.title}</span></h3>
              <p class="proj__desc">{p.description}</p>
              <dl class="proj__meta mono">
                <div><dt>Type</dt><dd>{p.kind}</dd></div>
                <div><dt>Role</dt><dd>{p.role}</dd></div>
                <div><dt>Stack</dt><dd>{p.stack.join(', ')}</dd></div>
              </dl>
              {p.link === 'soon' ? (
                <p class="proj__link proj__link--soon mono">Launching soon</p>
              ) : (
                <a class="proj__link mono" href={p.link} target="_blank" rel="noopener" data-cursor="Visit ↗">
                  <span class="roll" data-roll>Visit the site</span> ↗
                </a>
              )}
            </div>
            <figure class="proj__media" data-proj-media>
              <img src={p.image} alt={`${p.title} website`} style={`aspect-ratio:${p.ratio}`} loading="lazy" decoding="async" />
            </figure>
          </div>
        </article>
      </>
    ))}
    <div class="stack__tail" aria-hidden="true" />
  </div>
</section>
