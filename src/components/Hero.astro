---
import { projects } from '../data/content.js';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__pin">
    <p class="hero__meta mono" data-hero-meta>
      <span>Creative developer</span>
      <span>Independent</span>
      <span class="hero__meta-end">Portfolio 2026</span>
    </p>

    <h1 class="hero__name display" id="hero-title" aria-label="Moussa Mamadou">
      <span class="hero__line hero__line--a" aria-hidden="true"><span class="hero__word" data-hero-word>Moussa</span></span>
      <span class="hero__line hero__line--b" aria-hidden="true"><span class="hero__word" data-hero-word>Mamadou</span></span>
    </h1>

    <figure class="hero__reel" data-reel>
      <div class="hero__frame">
        {projects.map((p, i) => (
          <img src={p.image} alt="" data-reel-img decoding="async" loading={i < 2 ? 'eager' : 'lazy'} />
        ))}
      </div>
    </figure>

    <p class="hero__foot mono" data-hero-meta>
      <span class="hero__tag">If you can dream it, I can code it (probably)</span>
      <span class="hero__cap" aria-hidden="true"><span data-reel-num>01/{String(projects.length).padStart(2, '0')}</span> <span data-reel-title>{projects[0].title}</span></span>
      <span>Scroll</span>
    </p>
  </div>
</section>
