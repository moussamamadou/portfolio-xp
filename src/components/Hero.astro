---
import { nav } from '../data/content.js';
---

<section class="slide slide--dark cover" id="top" aria-labelledby="cover-title">
  <img class="slide__bg" src="/textures/hide-dark.jpg" alt="" aria-hidden="true" data-parallax />
  <h1 class="cover__title big" id="cover-title" data-lines>Moussa Mamadou</h1>
  <div class="slide__foot cap" data-fade>
    <p>Creative developer<br />Independent</p>
    <p>If you can dream it,<br />I can code it (probably)</p>
  </div>
</section>

<section class="slide slide--grey index" id="index" aria-label="Index">
  <ol class="index__list">
    {
      nav.map(({ id, label, caption }, i) => (
        <li class="rule" style={`--i:${i}`} data-rule>
          <a class="index__row" href={`#${id}`} data-scroll-to>
            <span class="index__label big"><span data-rise>({i + 1}) {label}</span></span>
            <span class="index__cap cap">{caption}</span>
          </a>
        </li>
      ))
    }
  </ol>
</section>
