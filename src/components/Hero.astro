---
const name = ['Moussa', 'Mamadou'];
---

<section class="hero" id="top" aria-label="Intro">
  <div class="hero__meta grid t-small">
    <p class="hero__cell hero__cell--a" data-hero-meta>(Portfolio ©2026)</p>
    <p class="hero__cell hero__cell--b" data-hero-meta>(00)<br />Intro</p>
    <p class="hero__cell hero__cell--c" data-hero-meta>
      Based somewhere on Earth<br /><span class="hero__coords" data-coords>00.0000° N, 00.0000° E</span>
    </p>
    <p class="hero__cell hero__cell--d" data-hero-meta>Scroll ↓</p>
  </div>

  <div class="hero__tagline grid">
    <p class="hero__tag" data-hero-tag>
      If You Can Dream It,<br />I Can Code It <span class="hero__probably">(Probably)</span>.
    </p>
  </div>

  <div class="hero__stage" data-hero-stage>
    <h1 class="hero__name" aria-label="Moussa Mamadou" data-hero-name>
      {
        name.map((w) => (
          <span class="hero__line" aria-hidden="true">
            <span class="hero__word" data-fit data-hero-word>{w}</span>
          </span>
        ))
      }
    </h1>
    <div class="hero__lens" aria-hidden="true" data-lens>
      <div class="hero__lens-inner" data-lens-inner>
        <div class="hero__name hero__name--lens">
          {
            name.map((w) => (
              <span class="hero__line">
                <span class="hero__word" data-fit>{w}</span>
              </span>
            ))
          }
        </div>
      </div>
      <span class="hero__lens-label t-small" data-lens-label>Hi.</span>
    </div>
  </div>
</section>
