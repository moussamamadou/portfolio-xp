<section class="hero" id="top" aria-label="Intro">
  <div class="hero__inner">
    <div class="hero__meta mono">
      <p data-hero-meta>Creative Developer — Independent</p>
      <p data-hero-meta class="hero__where">
        Based somewhere on Earth <span class="hero__coords" data-coords>(0.0000° N, 0.0000° E)</span>
      </p>
    </div>

    <h1 class="hero__name" aria-label="Moussa Mamadou">
      <span class="hero__line hero__line--1" aria-hidden="true" data-hero-line>Moussa</span>
      <span class="hero__line hero__line--2" aria-hidden="true" data-hero-line>Mamadou<span class="hero__dot"></span></span>
