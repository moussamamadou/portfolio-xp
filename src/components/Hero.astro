      <a href="#about" class="hero__scroll" data-scroll-to aria-label="Scroll to About">
        <svg viewBox="0 0 120 120" aria-hidden="true">
          <defs><path id="circle-path" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" /></defs>
          <text><textPath href="#circle-path">scroll down • keep going • it gets better • </textPath></text>
        </svg>
        <span class="hero__scroll-arrow" aria-hidden="true">↓</span>
