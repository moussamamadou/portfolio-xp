---
// The editorial row that opens every section: a hairline that draws itself,
// then the index, the name and a note sitting in their grid cells.
interface Props {
  num: string;
  label: string;
  note?: string;
  count?: string;
}
const { num, label, note, count } = Astro.props;
---

<div class="shead grid" data-shead>
  <span class="shead__rule" aria-hidden="true"></span>
  <p class="shead__num t-small"><span>({num})</span></p>
  <p class="shead__label t-small"><span>{label}</span></p>
  {note && <p class="shead__note t-small"><span>{note}</span></p>}
  <p class="shead__count t-small"><span>{count ?? '↘'}</span></p>
</div>
