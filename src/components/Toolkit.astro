---
import { skillGroups } from '../data/content.js';
---

<section class="toolkit" id="toolkit" aria-labelledby="toolkit-title">
  <header class="toolkit__head">
    <p class="kicker mono"><span>(04)</span><span>Toolkit</span></p>
    <h2 class="toolkit__title display" id="toolkit-title" data-toolkit-title>Toolkit</h2>
    <ul class="toolkit__legend mono">
      {skillGroups.map((g) => <li class={`legend legend--${g.id}`}>{g.title}</li>)}
    </ul>
  </header>

  <div class="pit" data-pit>
    <p class="pit__hint mono" aria-hidden="true">Grab one. Throw it.</p>
    {skillGroups.map((g) =>
      g.items.map((t) => (
        <button type="button" class={`pill pill--${g.id} display`} data-pill data-note={t.note}>
          {t.name}
        </button>
      )),
    )}
    <p class="pit__note display" data-pit-note aria-live="polite"></p>
  </div>
</section>
