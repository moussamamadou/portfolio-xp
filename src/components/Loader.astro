<div class="loader" id="loader" role="status" aria-live="polite">
  <div class="loader__top grid t-small">
    <p class="loader__name">Moussa Mamadou<sup>©</sup></p>
    <p class="loader__line" data-loader-line></p>
    <button class="loader__skip" type="button">Skip</button>
  </div>
  <div class="loader__bar" aria-hidden="true"><span data-loader-bar></span></div>
  <div class="loader__bottom grid">
    <p class="loader__visit t-small" data-loader-visit></p>
    <p class="loader__count" aria-hidden="true" data-loader-count></p>
  </div>
</div>
