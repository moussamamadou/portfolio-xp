---
import { route, formula } from '../data/content.js';
---

<section class="slide slide--light about" id="about" aria-labelledby="about-title">
  <img class="slide__bg" src="/textures/hide-light.jpg" alt="" aria-hidden="true" data-parallax />
  <div class="slide__body">
    <h2 class="about__title big" id="about-title" data-lines>A software engineer who doesn't hate design</h2>
    <div class="about__notes cap" data-fade>
      <p>Whatever idea you throw my way, the answer is: yes, it's possible*.</p>
      <p>{route.map((r) => r.title).join(', then ')}.</p>
      <p>{formula.join(' + ')} = creative development.</p>
      <p>* Terms and conditions may apply to physics.</p>
    </div>
  </div>
  <div class="slide__foot">
    <p class="slide__num big" aria-hidden="true">(1)</p>
    <p class="cap">Who is this guy?</p>
  </div>
</section>
