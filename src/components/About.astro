---
import { route, formula } from '../data/content.js';
---

<section class="about section" id="about" aria-labelledby="about-title">
  <p class="kicker mono"><span>(01)</span><span>About</span><span>Who am I?</span></p>

  <h2 class="about__statement" id="about-title" data-lines>
    A software engineer who doesn't hate design. Whatever idea you throw my way, the answer is: yes, it's possible<sup>*</sup>
  </h2>

  <div class="about__facts">
    <p class="about__terms mono" data-rise>* Terms and conditions may apply to physics.</p>

    <div class="fact" data-rise>
      <h3 class="fact__label mono">(Route)</h3>
      <ol class="fact__list mono">
        {route.map((r, i) => (
          <li><span class="fact__n">0{i + 1}</span><span>{r.title}</span></li>
        ))}
      </ol>
    </div>

    <div class="fact" data-rise>
      <h3 class="fact__label mono">(Formula)</h3>
      <p class="fact__formula mono">
        {formula.map((f, i) => <span>{f}{i < formula.length - 1 ? ' +' : ''}</span>)}
        <span class="fact__result">= Creative development</span>
      </p>
    </div>
  </div>
</section>
