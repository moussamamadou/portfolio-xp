---
import { route, formula } from '../data/content.js';
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="about__pin">
    <p class="kicker mono"><span>(01)</span><span>About</span></p>

    <h2 class="about__text display" id="about-title" data-words>
      A software engineer who doesn't hate design. Whatever you throw my way, the answer is yes, it's possible*
    </h2>

    <div class="route" data-route>
      <div class="route__track" aria-hidden="true"><span class="route__fill"></span></div>
      <ol class="route__stops mono">
        {route.map((r) => (
          <li class="route__stop" data-stop>
            <span class="route__tag">{r.tag}</span>
            <span class="route__title">{r.title}</span>
          </li>
        ))}
      </ol>
    </div>

    <p class="about__foot mono">
      <span data-formula>{formula.join(' + ')} = Creative development</span>
      <span class="about__terms">* Terms and conditions may apply to physics</span>
    </p>
  </div>
</section>
